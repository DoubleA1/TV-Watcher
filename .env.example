# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL="postgresql://user:password@localhost:5432/tvwatcher"

# TMDB — free for non-commercial use. https://www.themoviedb.org/settings/api
# Watch-provider data is supplied by JustWatch and requires attribution.
TMDB_API_KEY=""

# TVmaze needs no key.

# Session cookie signing. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Notifications. Leave Twilio blank until A2P 10DLC registration clears;
# the SMS adapter stays dark and email is used instead.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

RESEND_API_KEY=""
EMAIL_FROM="TV-Watcher <alerts@example.com>"

# Shared secret required by the poller endpoints (/api/cron/*).
CRON_SECRET=""
